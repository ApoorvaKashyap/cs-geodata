# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379

# AWS credentials
AWS_ACCESS_KEY_ID=xxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxx
AWS_REGION=us-east-1
S3_BASE=bucket-name

# Working Directories
TEMP_PATH=/tmp/

# DuckDB Settings
DUCKDB_MEMORY_LIMIT=4GB

# Pipeline testing — cap the number of tehsils processed (unset or leave blank for production)
TEST_LIMIT_TEHSILS=10

# Admin Bounds
TEHSIL_BOUNDS=s3://bucket-name/prefix/tehsil_boundaries_vector.geojson

# Parquet Settings
PARQUET_COMPRESSION_LEVEL=15
